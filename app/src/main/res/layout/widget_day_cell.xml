<?xml version="1.0" encoding="utf-8"?>
<!-- Ячейка дня в сетке виджета (GridView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_root"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
        android:id="@+id/day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:text="@string/weekday_mon" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        android:orientation="horizontal"
        android:gravity="center">

        <View
            android:id="@+id/dot_low"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/dot_importance"
            android:visibility="invisible" />

        <View
            android:id="@+id/dot_medium"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/dot_importance"
            android:visibility="invisible" />

        <View
            android:id="@+id/dot_high"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/dot_importance"
            android:visibility="invisible" />
    </LinearLayout>
</LinearLayout>
